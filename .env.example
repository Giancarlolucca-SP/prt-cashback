# Database
DATABASE_URL="<DATABASE_URL_LOCAL_OU_SANDBOX>"

# JWT
JWT_SECRET="<JWT_SECRET_LOCAL_FORTE>"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
NODE_ENV=development

# AWS Rekognition — 1:1 face comparison (leave blank to use pixel-similarity fallback)
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID_LOCAL>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY_LOCAL>
AWS_REGION=us-east-1

# Supabase Storage — selfie storage (thumb + full)
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=<SUPABASE_SERVICE_KEY_LOCAL>
# Bucket name (create manually in Supabase Dashboard → Storage, set to private)
SUPABASE_STORAGE_BUCKET=selfies

STATION_NAME="Posto XYZ"
MIN_REDEMPTION_AMOUNT=10.00
MAX_DAILY_REDEMPTION=500.00
REDEMPTION_COOLDOWN_MINUTES=5
