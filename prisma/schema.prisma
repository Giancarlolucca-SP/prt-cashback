generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Establishment {
  id                   String            @id @default(uuid())
  name                 String
  cnpj                 String            @unique
  cashbackPercent      Decimal           @default(5) @db.Decimal(5, 2)
  minRedemption        Decimal?          @db.Decimal(10, 2)
  phone                String?
  address              String?
  city                 String?
  state                String?
  latitude             Decimal?          @db.Decimal(10, 7)
  longitude            Decimal?          @db.Decimal(10, 7)
  logoUrl              String?
  primaryColor         String            @default("#FF6B00")
  secondaryColor       String            @default("#1e293b")
  createdAt            DateTime          @default(now())
  operators            Operator[]
  customers            Customer[]
  transactions         Transaction[]
  redemptions          Redemption[]
  campaigns            Campaign[]
  fraudSettings        FraudSettings?
  cashbackSettings     CashbackSettings?
  blacklistedCpfs      BlacklistedCpf[]
  messageQueue         MessageQueue[]
  attendantRatings     AttendantRating[]
  attendants           Attendant[]
  redemptionRequests   RedemptionRequest[]
  abastecimentos       Abastecimento[]
  pistaFuelMaps        PistaFuelMap[]
  pistaCardMaps        PistaCardMap[]
  concentradorConfig   ConcentradorConfig?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String            @default("ACTIVE")
  subscriptionEndsAt   DateTime?
}

model Customer {
  id                 String            @id @default(uuid())
  name               String
  cpf                String
  phone              String
  balance            Decimal           @default(0) @db.Decimal(10, 2)
  establishmentId    String
  deviceId           String?
  selfieData         String?           @db.Text // legacy inline base64 (kept for backward compat)
  selfieThumbnailUrl String? // Supabase — 100×100 thumb (face comparison)
  selfieFullUrl      String? // Supabase — 400×400 full (audit/admin)
  selfieStoragePath  String? // base path: selfies/{estId}/{custId}
  lastVerifiedAt     DateTime? // timestamp of last successful face verification
  pushToken          String?
  lastLat            Decimal?          @db.Decimal(10, 7)
  lastLng            Decimal?          @db.Decimal(10, 7)
  lastLocAt          DateTime?
  registered         Boolean           @default(true) // false = stub created by pista accrual (CPF without account yet)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  establishment      Establishment     @relation(fields: [establishmentId], references: [id])
  transactions       Transaction[]
  redemptions        Redemption[]
  fraudAlerts        FraudAlert[]
  attendantRatings   AttendantRating[]
  redemptionRequests RedemptionRequest[]

  @@unique([cpf, establishmentId])
  @@index([establishmentId])
}

model Operator {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(OPERATOR)
  establishmentId String?
  createdAt       DateTime         @default(now())
  establishment   Establishment?   @relation(fields: [establishmentId], references: [id])
  transactions    Transaction[]
  redemptions     Redemption[]
  campaigns       Campaign[]
  blacklistedCpfs BlacklistedCpf[]
  attendants      Attendant[]
}

model Transaction {
  id                String           @id @default(uuid())
  customerId        String
  operatorId        String
  establishmentId   String
  amount            Decimal          @db.Decimal(10, 2)
  cashbackPercent   Decimal          @db.Decimal(5, 2)
  cashbackValue     Decimal          @db.Decimal(10, 2)
  receiptCode       String           @unique
  fuelType          String?
  liters            Decimal?         @db.Decimal(10, 3)
  nfceKey           String?          @unique
  source            String?
  status            String           @default("CONFIRMED")
  retryCount        Int              @default(0)
  validatedAt       DateTime?
  qrCodeUrl         String?          @db.Text
  photoUrl          String?          @db.Text
  metadata          Json?
  attendantName     String?
  attendantId       String?          // resolved individual frentista (Pista card map), distinct from the shared operatorId
  encerranteInicial Decimal?         @db.Decimal(12, 3)
  encerranteFinal   Decimal?         @db.Decimal(12, 3)
  createdAt         DateTime         @default(now())
  customer          Customer         @relation(fields: [customerId], references: [id])
  operator          Operator         @relation(fields: [operatorId], references: [id])
  establishment     Establishment    @relation(fields: [establishmentId], references: [id])
  attendant         Attendant?       @relation(fields: [attendantId], references: [id])
  rating            AttendantRating?

  @@index([customerId])
  @@index([establishmentId])
  @@index([createdAt])
  @@index([status])
  @@index([attendantId])
}

model Redemption {
  id              String           @id @default(uuid())
  customerId      String
  operatorId      String
  establishmentId String
  amountUsed      Decimal          @db.Decimal(10, 2)
  status          RedemptionStatus @default(CONFIRMED)
  receiptCode     String           @unique
  source          String?          // e.g. "PISTA" — internal cashback panel
  metadata        Json?            // non-fiscal comprovante reference (bomba/value/frentista)
  attendantId     String?          // resolved individual frentista, distinct from the shared operatorId
  createdAt       DateTime         @default(now())
  customer        Customer         @relation(fields: [customerId], references: [id])
  operator        Operator         @relation(fields: [operatorId], references: [id])
  establishment   Establishment    @relation(fields: [establishmentId], references: [id])
  attendant       Attendant?       @relation(fields: [attendantId], references: [id])

  @@index([customerId])
  @@index([establishmentId])
  @@index([attendantId])
  @@index([createdAt])
}

model Campaign {
  id              String         @id @default(uuid())
  establishmentId String
  operatorId      String
  name            String         @default("")
  filterType      FilterType
  filterPeriod    FilterPeriod
  rewardType      RewardType
  rewardValue     Decimal        @db.Decimal(10, 2)
  message         String
  customerCount   Int
  totalCost       Decimal        @db.Decimal(10, 2)
  status          CampaignStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  establishment   Establishment  @relation(fields: [establishmentId], references: [id])
  operator        Operator       @relation(fields: [operatorId], references: [id])

  @@index([establishmentId])
  @@index([createdAt])
}

model CashbackSettings {
  id                        String        @id @default(uuid())
  establishmentId           String        @unique
  mode                      CashbackMode  @default(PERCENTAGE)
  defaultPercent            Decimal       @default(5) @db.Decimal(5, 2)
  defaultCentsPerLiter      Decimal       @default(0.05) @db.Decimal(8, 4)
  fuelTypes                 Json          @default("{}")
  minFuelAmount             Decimal       @default(0) @db.Decimal(10, 2)
  maxCashbackPerTransaction Decimal       @default(50) @db.Decimal(10, 2)
  doubleBonus               Boolean       @default(false)
  doubleBonusStart          DateTime?
  doubleBonusEnd            DateTime?
  rushHourBonus             Boolean       @default(false)
  rushHourStart             String        @default("06:00")
  rushHourEnd               String        @default("10:00")
  rushHourPercent           Decimal       @default(10) @db.Decimal(5, 2)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  establishment             Establishment @relation(fields: [establishmentId], references: [id])
}

model FraudSettings {
  id                    String        @id @default(uuid())
  establishmentId       String        @unique
  maxFuelsPerDay        Int           @default(1)
  maxFuelsPerWeek       Int           @default(3)
  maxCashbackPerDay     Decimal       @default(50) @db.Decimal(10, 2)
  maxFuelAmount         Decimal       @default(500) @db.Decimal(10, 2)
  maxRedeemsPerWeek     Int           @default(2)
  alertOnCashbackExceed Boolean       @default(true)
  alertOnSuspiciousHour Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  establishment         Establishment @relation(fields: [establishmentId], references: [id])
}

model BlacklistedCpf {
  id              String        @id @default(uuid())
  establishmentId String
  cpf             String
  reason          String
  blockedBy       String
  createdAt       DateTime      @default(now())
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  operator        Operator      @relation(fields: [blockedBy], references: [id])

  @@unique([cpf, establishmentId])
  @@index([establishmentId])
}

model MessageQueue {
  id              String    @id @default(uuid())
  establishmentId String
  campaignId      String?
  customerId      String?
  customerPhone   String
  customerName    String
  message         String
  status          String    @default("PENDING")
  priority        Int       @default(0)
  scheduledAt     DateTime  @default(now())
  sentAt          DateTime?
  failedAt        DateTime?
  retryCount      Int       @default(0)
  errorMessage    String?
  createdAt       DateTime  @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@index([status, scheduledAt])
  @@index([establishmentId, status])
  @@index([campaignId])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String
  operatorId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum CashbackMode {
  PERCENTAGE
  CENTS_PER_LITER
}

enum Role {
  SUPERADMIN
  ADMIN
  OPERATOR
}

enum RedemptionStatus {
  CONFIRMED
  CANCELLED
}

enum FilterType {
  ACTIVE
  INACTIVE
}

enum FilterPeriod {
  ONE_MONTH
  TWO_MONTHS
  THREE_MONTHS
  ONE_YEAR
}

enum RewardType {
  PER_LITER
  FIXED
}

enum CampaignStatus {
  DRAFT
  SENT
  CLOSED
}

model FraudAlert {
  id              String         @id @default(uuid())
  customerId      String
  establishmentId String
  type            FraudAlertType
  metadata        Json?
  resolved        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  customer        Customer       @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([establishmentId])
  @@index([createdAt])
}

enum FraudAlertType {
  DUPLICATE_QR
  DAILY_LIMIT_EXCEEDED
  WRONG_DEVICE
  VELOCITY_ANOMALY
  LOCATION_MISMATCH
  SELFIE_MISMATCH
}

model Abastecimento {
  id              String        @id @default(uuid())
  establishmentId String
  registro        Int                                  // R — register slot in concentrator memory
  nozzleCode      Int                                  // B — nozzle/bico code (from DT360)
  fuelCode        Int?                                 // derived fuel code (nullable until mapped)
  volumeLiters    Decimal       @db.Decimal(12, 3)
  totalValue      Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 3)
  fuelingDateTime DateTime
  encerranteFinal Decimal       @db.Decimal(14, 3)     // E — final totalizer
  attendantTag    String?                              // attendant tag (from identfidCode, nullable)
  identfidCode    String?                              // I[16] — raw Identfid card code (§3.1.3), nullable
  fuelName        String?                              // resolved via PistaFuelMap (nozzleCode → fuel)
  isAditivada     Boolean?                             // resolved via PistaFuelMap
  cashbackTransactionId String?  @unique               // set when cashback was applied (one per fueling)
  cashbackCpf     String?                              // CPF the cashback was credited to
  cashbackAppliedAt     DateTime?
  source          String        @default("CONCENTRADOR")
  rawPayload      String        @db.Text               // raw 50-char concentrator content
  createdAt       DateTime      @default(now())
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  // Idempotency: re-sends of the same fueling never duplicate
  @@unique([establishmentId, registro, encerranteFinal, fuelingDateTime])
  @@index([establishmentId, fuelingDateTime])
}

model PistaFuelMap {
  id              String        @id @default(uuid())
  establishmentId String
  nozzleCode      Int                                  // B — bico
  fuelName        String                               // cashback key, e.g. "gasolina", "gasolina_aditivada"
  isAditivada     Boolean       @default(false)        // owner's classification (for the mix metric)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@unique([establishmentId, nozzleCode])
  @@index([establishmentId])
}

model PistaCardMap {
  id              String        @id @default(uuid())
  establishmentId String
  identfidCode    String                               // I[16] — Identfid card code
  attendantId     String                               // links to the Attendant registry (identity source of truth)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  attendant       Attendant     @relation(fields: [attendantId], references: [id])

  @@unique([establishmentId, identfidCode])
  @@index([establishmentId])
  @@index([attendantId])
}

// Companytec concentrador (DT435 protocol) TCP connection settings for the local
// pista-agent — configured centrally here so a station's agent can pick up
// changes on restart instead of requiring someone to edit its local .env.
model ConcentradorConfig {
  id              String        @id @default(uuid())
  establishmentId String        @unique
  host            String        @default("127.0.0.1")
  port            Int           @default(2001)
  pollIntervalMs  Int           @default(1000)
  retryIntervalMs Int           @default(5000)
  socketTimeoutMs Int           @default(8000)
  useChecksum     Boolean       @default(false)
  readMode        String        @default("identified")  // identified ("&A67", §3.1.3) | plain ("&A", §3.1.1)
  // Heartbeat — reported by the agent every ~20s so the admin screen can show
  // online/offline instead of "configured and hope for the best".
  lastHeartbeatAt DateTime?
  lastHeartbeatOk Boolean?                               // was the agent connected to the concentrador at that heartbeat
  lastError       String?       @db.Text
  agentVersion    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
}

model RedemptionRequest {
  id              String        @id @default(uuid())
  customerId      String
  establishmentId String
  amount          Decimal       @db.Decimal(10, 2)        // amount the customer wants to redeem
  status          String        @default("PENDING")       // PENDING | CONFIRMED | CANCELLED
  operatorId      String?                                 // shared operator login that resolved it
  attendantId     String?                                 // individual frentista who resolved it (Pista card map)
  redemptionId    String?       @unique                   // created Redemption (when confirmed)
  note            String?                                 // reference abastecimento / bomba
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?
  customer        Customer      @relation(fields: [customerId], references: [id])
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  attendant       Attendant?    @relation(fields: [attendantId], references: [id])

  @@index([establishmentId, status])
  @@index([customerId])
  @@index([attendantId])
}

model Attendant {
  id              String        @id @default(uuid())
  establishmentId String
  name            String                         // display name, e.g. "JUNIOR"
  code            String?                        // pump/operator code, e.g. "27"
  attendantKey    String                         // ranking key, e.g. "27-JUNIOR" (matches Transaction.attendantName)
  photoUrl        String?                        // Supabase 'attendants' bucket public URL
  active          Boolean       @default(true)
  operatorId      String?                        // optional link to an Operator login (auto-filter self-view)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  operator        Operator?     @relation(fields: [operatorId], references: [id])
  cardMaps        PistaCardMap[]
  transactions        Transaction[]
  redemptionRequests  RedemptionRequest[]
  redemptions         Redemption[]

  @@unique([establishmentId, attendantKey])
  @@index([establishmentId])
  @@index([operatorId])
}

model AttendantRating {
  id              String        @id @default(uuid())
  stars           Int // 1–5, validated in the service layer
  comment         String?       @db.Text // optional free text — admin/operator only
  attendantName   String // same key the ranking groups by ("code-name")
  customerId      String // who submitted the rating
  transactionId   String?       @unique // one rating per transaction
  establishmentId String // multi-establishment isolation
  createdAt       DateTime      @default(now())
  customer        Customer      @relation(fields: [customerId], references: [id])
  transaction     Transaction?  @relation(fields: [transactionId], references: [id])
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@index([establishmentId])
  @@index([attendantName])
  @@index([createdAt])
}
