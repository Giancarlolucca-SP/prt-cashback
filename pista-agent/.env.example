# ── Concentrador Companytec ──────────────────────────────────────────────
# Emulador SimuladorCBC: 127.0.0.1 : 2001   |   Concentrador real: porta 857
CONCENTRADOR_HOST=127.0.0.1
CONCENTRADOR_PORT=2001
POLL_INTERVAL_MS=1000
RETRY_INTERVAL_MS=5000
SOCKET_TIMEOUT_MS=8000
# false: envia "(&A)" sem checksum (padrão p/ emulador). true: envia "(&A67)".
USE_CHECKSUM=false
# identified: leitura identificada "(&A67)" (§3.1.3 — captura o Identfid/frentista) [padrão]
# plain:      leitura simples "(&A)" (§3.1.1)
READ_MODE=identified

# ── Nuvem PostoCash ──────────────────────────────────────────────────────
POSTOCASH_API_URL=http://127.0.0.1:3000
AGENT_TOKEN=
ESTABLISHMENT_ID=
