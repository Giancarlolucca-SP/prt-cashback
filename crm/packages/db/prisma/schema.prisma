generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id         String       @id @default(uuid())
  name       String
  legalName  String?      @map("legal_name")
  cnpj       String?      @unique
  stateTaxId String?      @map("state_tax_id")
  taxRegime  String?      @map("tax_regime")
  cnaes      String[]     @default([])
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")

  users User[]

  @@map("stores")
}

model User {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  preferences UserPreference[]
  store       Store            @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

model Role {
  id          String       @id @default(uuid())
  storeId     String?      @map("store_id")
  code        String
  name        String
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@unique([storeId, code])
  @@index([storeId])
  @@map("roles")
}

model Permission {
  id            String              @id @default(uuid())
  module        String
  action        String
  scope         PermissionScopeType
  sensitiveArea String?             @map("sensitive_area")
  description   String?
  status        RecordStatus        @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([module, action, scope, sensitiveArea])
  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  permissionId String           @map("permission_id")
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([userId, permissionId, effect])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model PermissionScope {
  id         String              @id @default(uuid())
  userId     String              @map("user_id")
  module     String
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id")
  scope      PermissionScopeType
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([userId])
  @@index([module])
  @@index([entityType, entityId])
  @@map("permission_scopes")
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  revokedAt     DateTime? @map("revoked_at")
  forceReauthAt DateTime? @map("force_reauth_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")

  @@index([userId])
  @@index([revokedAt])
  @@map("user_sessions")
}

model UserResponsibilityTransfer {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  fromUserId    String   @map("from_user_id")
  toUserId      String   @map("to_user_id")
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  reason        String?
  transferredBy String   @map("transferred_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([entityType, entityId])
  @@map("user_responsibility_transfers")
}

model StoreSetting {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, key])
  @@map("store_settings")
}

model StoreTaxSetting {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  name          String
  taxRegime     String?   @map("tax_regime")
  profitTaxRate Decimal?  @map("profit_tax_rate") @db.Decimal(6, 4)
  snapshot      Json?
  validFrom     DateTime  @default(now()) @map("valid_from")
  validTo       DateTime? @map("valid_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([storeId])
  @@map("store_tax_settings")
}

model AccountantSetting {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  email     String?
  phone     String?
  document  String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@map("accountant_settings")
}

model BusinessHour {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  weekday   Int
  opensAt   String?  @map("opens_at")
  closesAt  String?  @map("closes_at")
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, weekday])
  @@map("business_hours")
}

model StoreHoliday {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  date        DateTime
  name        String
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId, date])
  @@map("store_holidays")
}

model OperationalDeadline {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  module    String
  action    String
  hours     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, module, action])
  @@map("operational_deadlines")
}

model ConfigurableCategory {
  id        String       @id @default(uuid())
  storeId   String       @map("store_id")
  domain    String
  name      String
  metadata  Json?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([storeId, domain, name])
  @@index([storeId, domain])
  @@map("configurable_categories")
}

model DocumentTemplate {
  id        String       @id @default(uuid())
  storeId   String       @map("store_id")
  name      String
  module    String
  version   Int          @default(1)
  content   String
  snapshot  Json?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([storeId, name, version])
  @@index([storeId, module])
  @@map("document_templates")
}

model MessageTemplate {
  id        String       @id @default(uuid())
  storeId   String       @map("store_id")
  name      String
  channel   String
  version   Int          @default(1)
  content   String
  variables Json?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([storeId, name, version])
  @@index([storeId, channel])
  @@map("message_templates")
}

model OperationalParameter {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  key       String
  value     Json
  snapshot  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, key])
  @@map("operational_parameters")
}

model Customer {
  id              String       @id @default(uuid())
  storeId         String       @map("store_id")
  type            CustomerType @default(PERSON)
  name            String
  document        String?
  email           String?
  phone           String?
  birthDate       DateTime?    @map("birth_date")
  origin          String?
  notes           String?
  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @map("created_by_user_id")
  updatedByUserId String?      @map("updated_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  @@unique([storeId, document])
  @@index([storeId])
  @@index([phone])
  @@map("customers")
}

model PostSaleCustomer {
  id               String       @id @default(uuid())
  storeId          String       @map("store_id")
  customerId       String?      @map("customer_id")
  name             String
  phone            String?
  email            String?
  vehicleInfo      String?      @map("vehicle_info")
  recurrenceStatus String?      @map("recurrence_status")
  totalRevenue     Decimal?     @map("total_revenue") @db.Decimal(14, 2)
  lastServiceAt    DateTime?    @map("last_service_at")
  nextActionAt     DateTime?    @map("next_action_at")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  @@index([storeId])
  @@index([customerId])
  @@map("post_sale_customers")
}

model CustomerContact {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  type       String
  value      String
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  label      String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?  @map("zip_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerHistoryEvent {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  customerId  String   @map("customer_id")
  type        String
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([customerId, occurredAt])
  @@map("customer_history_events")
}

model CustomerInteraction {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  channel    String
  summary    String?
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([customerId, occurredAt])
  @@index([entityType, entityId])
  @@map("customer_interactions")
}

model PrivacyPreference {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  channel    String
  allowed    Boolean  @default(true)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([customerId, channel])
  @@index([storeId])
  @@map("privacy_preferences")
}

model CustomerRelationshipFlag {
  id         String       @id @default(uuid())
  storeId    String       @map("store_id")
  customerId String       @map("customer_id")
  flag       String
  metadata   Json?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([customerId])
  @@map("customer_relationship_flags")
}

model Lead {
  id             String     @id @default(uuid())
  storeId        String     @map("store_id")
  customerId     String?    @map("customer_id")
  assignedUserId String?    @map("assigned_user_id")
  vehicleId      String?    @map("vehicle_id")
  source            String?
  title             String
  status            LeadStatus @default(NEW)
  interest          String?
  temperature       Int?
  channel           String?
  campaign          String?
  contactedAt       DateTime?  @map("contacted_at")
  lastInteractionAt DateTime?  @map("last_interaction_at")
  nextActionAt      DateTime?  @map("next_action_at")
  createdByUserId   String?    @map("created_by_user_id")
  updatedByUserId   String?    @map("updated_by_user_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  cards LeadCard[]

  @@index([storeId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([vehicleId])
  @@index([status, nextActionAt])
  @@index([storeId, lastInteractionAt])
  @@map("leads")
}

model LeadCard {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  leadId         String    @map("lead_id")
  boardKey       String    @map("board_key")
  stageKey       String    @map("stage_key")
  position       Int       @default(0)
  stageEnteredAt DateTime  @default(now()) @map("stage_entered_at")
  archivedAt     DateTime? @map("archived_at")
  lostReason     String?   @map("lost_reason")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lead                   Lead                    @relation(fields: [leadId], references: [id])
  commercialAppointments CommercialAppointment[]

  @@index([storeId, boardKey, stageKey])
  @@index([storeId, boardKey, archivedAt])
  @@index([leadId])
  @@map("lead_cards")
}

model CommercialAppointment {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  cardId              String    @map("card_id")
  leadId              String?   @map("lead_id")
  customerId          String?   @map("customer_id")
  vehicleId           String?   @map("vehicle_id")
  vehicleInterest     Json?     @map("vehicle_interest")
  responsibleUserId   String    @map("responsible_user_id")
  type                String
  status              String    @default("SCHEDULED")
  startsAt            DateTime  @map("starts_at")
  endsAt              DateTime? @map("ends_at")
  location            String?
  origin              String?
  channel             String?
  notes               String?
  cancelReason        String?   @map("cancel_reason")
  noShowReason        String?   @map("no_show_reason")
  rescheduleFromId    String?   @map("reschedule_from_id")
  sourceAppointmentId String?   @map("source_appointment_id")
  createdByUserId     String?   @map("created_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  card            LeadCard                @relation(fields: [cardId], references: [id])
  rescheduledFrom CommercialAppointment?  @relation("CommercialAppointmentReschedule", fields: [rescheduleFromId], references: [id])
  reschedules     CommercialAppointment[] @relation("CommercialAppointmentReschedule")

  @@index([storeId, startsAt])
  @@index([storeId, status])
  @@index([cardId])
  @@index([responsibleUserId])
  @@index([leadId])
  @@map("commercial_appointments")
}

model LeadStageHistory {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  leadId      String   @map("lead_id")
  fromStage   String?  @map("from_stage")
  toStage     String   @map("to_stage")
  actorUserId String?  @map("actor_user_id")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([leadId, createdAt])
  @@map("lead_stage_history")
}

model LeadAssignment {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  leadId           String    @map("lead_id")
  assignedUserId   String    @map("assigned_user_id")
  assignedByUserId String?   @map("assigned_by_user_id")
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  releasedAt       DateTime? @map("released_at")

  @@index([storeId])
  @@index([leadId])
  @@index([assignedUserId])
  @@map("lead_assignments")
}

model Appointment {
  id             String            @id @default(uuid())
  storeId        String            @map("store_id")
  customerId     String?           @map("customer_id")
  leadId         String?           @map("lead_id")
  vehicleId      String?           @map("vehicle_id")
  assignedUserId String?           @map("assigned_user_id")
  type           String
  title          String
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime?         @map("ends_at")
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  @@index([storeId, startsAt])
  @@index([customerId])
  @@index([leadId])
  @@map("appointments")
}

model FollowUp {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  leadId         String?   @map("lead_id")
  customerId     String?   @map("customer_id")
  assignedUserId String?   @map("assigned_user_id")
  type           String
  dueAt          DateTime  @map("due_at")
  completedAt    DateTime? @map("completed_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([storeId, dueAt])
  @@index([leadId])
  @@index([customerId])
  @@map("follow_ups")
}

model Vehicle {
  id        String       @id @default(uuid())
  storeId   String       @map("store_id")
  brand     String
  model     String
  version   String?
  yearModel Int?         @map("year_model")
  yearBuild Int?         @map("year_build")
  plate     String?
  vin       String?
  color     String?
  mileage   Int?
  fipeCode  String?      @map("fipe_code")
  relevantOptions String? @map("relevant_options")
  primaryPhotoAttachmentId String? @map("primary_photo_attachment_id")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([storeId, plate])
  @@index([primaryPhotoAttachmentId])
  @@index([storeId])
  @@index([vin])
  @@map("vehicles")
}

model VehicleInventoryRecord {
  id              String               @id @default(uuid())
  storeId         String               @map("store_id")
  vehicleId       String               @map("vehicle_id")
  ownershipType   VehicleOwnershipType @map("ownership_type")
  status          InventoryStatus      @default(IN_PREPARATION)
  ownerCustomerId String?              @map("owner_customer_id")
  responsibleUserId String?            @map("responsible_user_id")
  stockOrigin     String?              @map("stock_origin")
  stockLocation   String?              @map("stock_location")
  purchaseCost    Decimal?             @map("purchase_cost") @db.Decimal(14, 2)
  askingPrice     Decimal?             @map("asking_price") @db.Decimal(14, 2)
  entryDate       DateTime             @default(now()) @map("entry_date")
  exitDate        DateTime?            @map("exit_date")
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  @@index([storeId, status])
  @@index([vehicleId])
  @@index([ownershipType])
  @@index([responsibleUserId])
  @@index([stockOrigin])
  @@index([stockLocation])
  @@map("vehicle_inventory_records")
}

model VehicleCost {
  id                     String    @id @default(uuid())
  storeId                String    @map("store_id")
  vehicleId              String    @map("vehicle_id")
  inventoryId            String?   @map("inventory_id")
  category               String
  description            String
  amount                 Decimal   @db.Decimal(14, 2)
  occurredAt             DateTime  @default(now()) @map("occurred_at")
  capitalized            Boolean   @default(true)
  financialTransactionId String?   @map("financial_transaction_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  @@index([storeId])
  @@index([vehicleId])
  @@index([inventoryId])
  @@map("vehicle_costs")
}

model VehiclePreparationItem {
  id             String       @id @default(uuid())
  storeId        String       @map("store_id")
  vehicleId      String       @map("vehicle_id")
  serviceOrderId String?      @map("service_order_id")
  title          String
  status         RecordStatus @default(ACTIVE)
  dueAt          DateTime?    @map("due_at")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([vehicleId])
  @@map("vehicle_preparation_items")
}

model VehicleInspection {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  vehicleId         String   @map("vehicle_id")
  type              String
  result            String?
  checklist         Json?
  inspectedByUserId String?  @map("inspected_by_user_id")
  inspectedAt       DateTime @default(now()) @map("inspected_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([vehicleId])
  @@map("vehicle_inspections")
}

model VehicleStatusHistory {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  vehicleId   String   @map("vehicle_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  actorUserId String?  @map("actor_user_id")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([vehicleId, createdAt])
  @@map("vehicle_status_history")
}

model VehicleMarginSnapshot {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  vehicleId    String   @map("vehicle_id")
  inventoryId  String?  @map("inventory_id")
  saleId       String?  @map("sale_id")
