generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id         String       @id @default(uuid())
  name       String
  legalName  String?      @map("legal_name")
  cnpj       String?      @unique
  stateTaxId String?      @map("state_tax_id")
  taxRegime  String?      @map("tax_regime")
  cnaes      String[]     @default([])
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")

  users User[]

  @@map("stores")
}

model User {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  preferences UserPreference[]
  store       Store            @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

model Role {
  id          String       @id @default(uuid())
  storeId     String?      @map("store_id")
  code        String
  name        String
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@unique([storeId, code])
  @@index([storeId])
  @@map("roles")
}

model Permission {
  id            String              @id @default(uuid())
  module        String
  action        String
  scope         PermissionScopeType
  sensitiveArea String?             @map("sensitive_area")
  description   String?
  status        RecordStatus        @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([module, action, scope, sensitiveArea])
  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  permissionId String           @map("permission_id")
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([userId, permissionId, effect])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model PermissionScope {
  id         String              @id @default(uuid())
  userId     String              @map("user_id")
  module     String
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id")
  scope      PermissionScopeType
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([userId])
  @@index([module])
  @@index([entityType, entityId])
  @@map("permission_scopes")
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  revokedAt     DateTime? @map("revoked_at")
  forceReauthAt DateTime? @map("force_reauth_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")

  @@index([userId])
  @@index([revokedAt])
  @@map("user_sessions")
}

model UserResponsibilityTransfer {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  fromUserId    String   @map("from_user_id")
  toUserId      String   @map("to_user_id")
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  reason        String?
  transferredBy String   @map("transferred_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([entityType, entityId])
  @@map("user_responsibility_transfers")
}

model StoreSetting {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, key])
  @@map("store_settings")
}

model StoreTaxSetting {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  name          String
  taxRegime     String?   @map("tax_regime")
  profitTaxRate Decimal?  @map("profit_tax_rate") @db.Decimal(6, 4)
  snapshot      Json?
  validFrom     DateTime  @default(now()) @map("valid_from")
  validTo       DateTime? @map("valid_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([storeId])
  @@map("store_tax_settings")
}

model AccountantSetting {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  email     String?
  phone     String?
  document  String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@map("accountant_settings")
}

model BusinessHour {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  weekday   Int
  opensAt   String?  @map("opens_at")
  closesAt  String?  @map("closes_at")
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, weekday])
  @@map("business_hours")
}

model StoreHoliday {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  date        DateTime
  name        String
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId, date])
  @@map("store_holidays")
}

model OperationalDeadline {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  module    String
  action    String
  hours     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, module, action])
  @@map("operational_deadlines")
}

model ConfigurableCategory {
  id        String       @id @default(uuid())
  storeId   String       @map("store_id")
  domain    String
  name      String
  metadata  Json?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([storeId, domain, name])
  @@index([storeId, domain])
  @@map("configurable_categories")
}

model DocumentTemplate {
  id        String       @id @default(uuid())
  storeId   String       @map("store_id")
  name      String
  module    String
  version   Int          @default(1)
  content   String
  snapshot  Json?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([storeId, name, version])
  @@index([storeId, module])
  @@map("document_templates")
}

model MessageTemplate {
  id        String       @id @default(uuid())
  storeId   String       @map("store_id")
  name      String
  channel   String
  version   Int          @default(1)
  content   String
  variables Json?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@unique([storeId, name, version])
  @@index([storeId, channel])
  @@map("message_templates")
}

model OperationalParameter {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  key       String
  value     Json
  snapshot  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, key])
  @@map("operational_parameters")
}

model Customer {
  id              String       @id @default(uuid())
  storeId         String       @map("store_id")
  type            CustomerType @default(PERSON)
  name            String
  document        String?
  email           String?
  phone           String?
  birthDate       DateTime?    @map("birth_date")
  origin          String?
  notes           String?
  status          RecordStatus @default(ACTIVE)
  createdByUserId String?      @map("created_by_user_id")
  updatedByUserId String?      @map("updated_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  @@unique([storeId, document])
  @@index([storeId])
  @@index([phone])
  @@map("customers")
}

model PostSaleCustomer {
  id               String       @id @default(uuid())
  storeId          String       @map("store_id")
  customerId       String?      @map("customer_id")
  name             String
  phone            String?
  email            String?
  vehicleInfo      String?      @map("vehicle_info")
  recurrenceStatus String?      @map("recurrence_status")
  totalRevenue     Decimal?     @map("total_revenue") @db.Decimal(14, 2)
  lastServiceAt    DateTime?    @map("last_service_at")
  nextActionAt     DateTime?    @map("next_action_at")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  @@index([storeId])
  @@index([customerId])
  @@map("post_sale_customers")
}

model PostSaleAlert {
  id                    String    @id @default(uuid())
  storeId               String    @map("store_id")
  customerId            String    @map("customer_id")
  saleId                String    @map("sale_id")
  vehicleId             String?   @map("vehicle_id")
  purchaseDate          DateTime  @map("purchase_date")
  triggerDate           DateTime  @map("trigger_date")
  feedbackDueAt         DateTime  @map("feedback_due_at")
  originalSellerUserId  String?   @map("original_seller_user_id")
  assignedUserId        String?   @map("assigned_user_id")
  status                String    @default("PENDING")
  contactAttemptedAt    DateTime? @map("contact_attempted_at")
  contactChannel        String?   @map("contact_channel")
  contactResult         String?   @map("contact_result")
  feedbackNotes         String?   @map("feedback_notes")
  nextActionAt          DateTime? @map("next_action_at")
  overdueNotificationId String?   @map("overdue_notification_id")
  closedAt              DateTime? @map("closed_at")
  closedByUserId        String?   @map("closed_by_user_id")
  reassignedFromUserId  String?   @map("reassigned_from_user_id")
  reassignedAt          DateTime? @map("reassigned_at")
  reassignedByUserId    String?   @map("reassigned_by_user_id")
  reassignedReason      String?   @map("reassigned_reason")
  createdByAutomation   Boolean   @default(true) @map("created_by_automation")
  createdByUserId       String?   @map("created_by_user_id")
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@unique([storeId, saleId, triggerDate])
  @@index([storeId, status])
  @@index([customerId])
  @@index([saleId])
  @@index([vehicleId])
  @@index([assignedUserId])
  @@index([feedbackDueAt])
  @@map("post_sale_alerts")
}

model PostSaleAlertEvent {
  id                  String   @id @default(uuid())
  storeId             String   @map("store_id")
  postSaleAlertId     String   @map("post_sale_alert_id")
  customerId          String   @map("customer_id")
  saleId              String   @map("sale_id")
  eventType           String   @map("event_type")
  actorUserId         String?  @map("actor_user_id")
  fromStatus          String?  @map("from_status")
  toStatus            String?  @map("to_status")
  fromAssignedUserId  String?  @map("from_assigned_user_id")
  toAssignedUserId    String?  @map("to_assigned_user_id")
  payload             Json?
  occurredAt          DateTime @default(now()) @map("occurred_at")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([postSaleAlertId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([saleId, occurredAt])
  @@map("post_sale_alert_events")
}

model PostSaleFeedback {
  id                     String    @id @default(uuid())
  storeId                String    @map("store_id")
  postSaleAlertId        String    @unique @map("post_sale_alert_id")
  customerId             String    @map("customer_id")
  saleId                 String    @map("sale_id")
  vehicleId              String?   @map("vehicle_id")
  originalSellerUserId   String?   @map("original_seller_user_id")
  assignedUserId         String?   @map("assigned_user_id")
  contactAt              DateTime  @map("contact_at")
  contactChannel         String    @map("contact_channel")
  contactResult          String    @map("contact_result")
  feedbackNotes          String?   @map("feedback_notes")
  hasPurchaseInterest    Boolean   @default(false) @map("has_purchase_interest")
  interestType           String    @default("NONE") @map("interest_type")
  vehicleInterestId      String?   @map("vehicle_interest_id")
  vehicleInterestNotes   String?   @map("vehicle_interest_notes")
  nextAction             String?   @map("next_action")
  nextActionAt           DateTime? @map("next_action_at")
  createdLeadId          String?   @map("created_lead_id")
  createdCardId          String?   @map("created_card_id")
  createdInternalIssueId String?   @map("created_internal_issue_id")
  createdByUserId        String    @map("created_by_user_id")
  updatedByUserId        String?   @map("updated_by_user_id")
  auditLogId             String?   @map("audit_log_id")
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  @@index([storeId])
  @@index([customerId])
  @@index([saleId])
  @@index([vehicleId])
  @@index([assignedUserId])
  @@index([contactResult])
  @@index([contactChannel])
  @@index([interestType])
  @@index([createdCardId])
  @@index([createdInternalIssueId])
  @@map("post_sale_feedbacks")
}

model PostSaleInternalIssue {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  postSaleFeedbackId  String    @map("post_sale_feedback_id")
  postSaleAlertId     String    @map("post_sale_alert_id")
  customerId          String    @map("customer_id")
  saleId              String    @map("sale_id")
  vehicleId           String?   @map("vehicle_id")
  issueType           String    @default("VEHICLE_PROBLEM") @map("issue_type")
  severity            String    @default("MEDIUM")
  status              String    @default("PENDING_REVIEW")
  description         String
  responsibleUserId   String?   @map("responsible_user_id")
  createdByUserId     String    @map("created_by_user_id")
  updatedByUserId     String?   @map("updated_by_user_id")
  resolvedAt          DateTime? @map("resolved_at")
  resolvedByUserId    String?   @map("resolved_by_user_id")
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  @@index([storeId, status])
  @@index([postSaleFeedbackId])
  @@index([postSaleAlertId])
  @@index([customerId])
  @@index([saleId])
  @@index([vehicleId])
  @@index([responsibleUserId])
  @@map("post_sale_internal_issues")
}

model CustomerContact {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  type       String
  value      String
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  label      String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?  @map("zip_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerHistoryEvent {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  customerId  String   @map("customer_id")
  type        String
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([customerId, occurredAt])
  @@map("customer_history_events")
}

model CustomerInteraction {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  channel    String
  summary    String?
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([customerId, occurredAt])
  @@index([entityType, entityId])
  @@map("customer_interactions")
}

model PrivacyPreference {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  customerId String   @map("customer_id")
  channel    String
  allowed    Boolean  @default(true)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([customerId, channel])
  @@index([storeId])
  @@map("privacy_preferences")
}

model CustomerRelationshipFlag {
  id         String       @id @default(uuid())
  storeId    String       @map("store_id")
  customerId String       @map("customer_id")
  flag       String
  metadata   Json?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([customerId])
  @@map("customer_relationship_flags")
}

model CustomerBirthdayProfile {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  customerId        String    @unique @map("customer_id")
  birthDay          Int       @map("birth_day")
  birthMonth        Int       @map("birth_month")
  birthDateSource   String    @default("UNKNOWN") @map("birth_date_source")
  birthDateConfidence Decimal? @map("birth_date_confidence") @db.Decimal(5, 4)
  confirmedByUserId String?   @map("confirmed_by_user_id")
  confirmedAt       DateTime? @map("confirmed_at")
  sourceDocumentId  String?   @map("source_document_id")
  status            String    @default("CONFIRMED")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([storeId, birthMonth, birthDay])
  @@index([storeId, status])
  @@index([customerId])
  @@map("customer_birthday_profiles")
}

model BirthdayMessage {
  id                  String    @id @default(uuid())
  storeId             String    @map("store_id")
  customerId          String    @map("customer_id")
  birthdayProfileId   String    @map("birthday_profile_id")
  templateId          String?   @map("template_id")
  templateVersion     Int?      @map("template_version")
  messageTextSnapshot String    @map("message_text_snapshot")
  channel             String
  sendStatus          String    @default("PREPARED") @map("send_status")
  responsibleUserId   String?   @map("responsible_user_id")
  preparedByUserId    String?   @map("prepared_by_user_id")
  preparedAt          DateTime  @default(now()) @map("prepared_at")
  sentAt              DateTime? @map("sent_at")
  sentByUserId        String?   @map("sent_by_user_id")
  responseText        String?   @map("response_text")
  responseAt          DateTime? @map("response_at")
  failedAt            DateTime? @map("failed_at")
  failureReason       String?   @map("failure_reason")
  optedOutAt          DateTime? @map("opted_out_at")
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  @@index([storeId, sendStatus])
  @@index([customerId])
  @@index([birthdayProfileId])
  @@index([templateId])
  @@index([preparedAt])
  @@index([sentAt])
  @@map("birthday_messages")
}

model Lead {
  id             String     @id @default(uuid())
  storeId        String     @map("store_id")
  customerId     String?    @map("customer_id")
  assignedUserId String?    @map("assigned_user_id")
  vehicleId      String?    @map("vehicle_id")
  source            String?
  title             String
  status            LeadStatus @default(NEW)
  interest          String?
  temperature       Int?
  channel           String?
  campaign          String?
  contactedAt           DateTime?  @map("contacted_at")
  lastInteractionAt     DateTime?  @map("last_interaction_at")
  lastInteractionType   String?    @map("last_interaction_type")
  lastInteractionResult String?    @map("last_interaction_result")
  nextActionAt          DateTime?  @map("next_action_at")
  nextActionType        String?    @map("next_action_type")
  createdByUserId   String?    @map("created_by_user_id")
  updatedByUserId   String?    @map("updated_by_user_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  cards LeadCard[]

  @@index([storeId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([vehicleId])
  @@index([status, nextActionAt])
  @@index([storeId, lastInteractionAt])
  @@map("leads")
}

model LeadCard {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  leadId         String    @map("lead_id")
  boardKey       String    @map("board_key")
  stageKey       String    @map("stage_key")
  position       Int       @default(0)
  stageEnteredAt DateTime  @default(now()) @map("stage_entered_at")
  archivedAt     DateTime? @map("archived_at")
  lostReason     String?   @map("lost_reason")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lead                   Lead                    @relation(fields: [leadId], references: [id])
  commercialAppointments CommercialAppointment[]
  commercialInteractions CommercialInteraction[]
  commercialAlerts       CommercialAlert[]

  @@index([storeId, boardKey, stageKey])
  @@index([storeId, boardKey, archivedAt])
  @@index([leadId])
