# App
NODE_ENV=development
APP_ENV=development
API_PORT=3333
WEB_PORT=3000
LOG_LEVEL=info

# Database - Docker local default
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5433/crm_automotivo?schema=public
DIRECT_URL=postgresql://crm_user:crm_password@localhost:5433/crm_automotivo?schema=public

# Database - PostgreSQL local Windows fallback
# Use in local .env when Docker/WSL is unavailable.
# DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_automotivo?schema=public
# DIRECT_URL=postgresql://crm_user:crm_password@localhost:5432/crm_automotivo?schema=public

# Database - Supabase Postgres fallback
# Use these values only in your local .env, never with real passwords in this example file.
# Copy the connection strings from Supabase Project Settings > Database.
# DATABASE_URL can use the pooled connection string for app runtime.
# DIRECT_URL must use the direct connection string for Prisma migrations.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public

# Supabase Storage
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-staging-secret
SUPABASE_STORAGE_BUCKET_CUSTOMER_DOCUMENTS=customer-documents
SUPABASE_STORAGE_BUCKET_VEHICLE_DOCUMENTS=vehicle-documents
SUPABASE_STORAGE_BUCKET_SALE_DOCUMENTS=sale-documents
SUPABASE_STORAGE_BUCKET_SERVICE_DOCUMENTS=service-documents
SUPABASE_STORAGE_BUCKET_SYSTEM_GENERATED=system-generated

# Jobs
JOB_SCHEMA=pgboss
WEBHOOK_SHARED_SECRET=replace-with-local-webhook-secret

# Security / rate limiting
RATE_LIMIT_AUTH_LOGIN_MAX=20
RATE_LIMIT_HONEYPOT_MAX=3
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_SENSITIVE_MAX=120
RATE_LIMIT_DEFAULT_MAX=600

# Backup
BACKUP_DIR=backups
# Optional on Windows if pg_dump/pg_restore are outside PATH and not under C:\Program Files\PostgreSQL\<version>\bin.
# POSTGRES_BIN_DIR=C:\Program Files\PostgreSQL\17\bin

# Integrations
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-local-secret
SMTP_HOST=localhost
SMTP_PORT=1025

# AI/OCR
OPENAI_API_KEY=replace-with-local-secret
OCR_PROVIDER=manual
